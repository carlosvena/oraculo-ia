<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#23162E"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sin racha todavía"
        android:textColor="#BFB2FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:text="Abrí la app para empezar tu recorrido."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_mission_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="CONTINUAR MI MISIÓN"
        android:textColor="#17171D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="#BFB2FF"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

</LinearLayout>
